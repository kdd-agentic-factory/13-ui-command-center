# Generated allowlist is evaluated inside nginx's http context.
include /etc/nginx/chassis-surface.map.conf;
map $request_uri $chassis_ambiguous_path {
    default 0;
    "~^[^?]*(%|//|/\\.\\.?(/|\\?|$))" 1;
}
map "$http_x_internal_api_key$http_x_principal_id$http_x_principal_role$http_x_execution_grant$http_x_coordinator_capability" $chassis_service_credential {
    "" 0;
    default 1;
}
map $http_authorization $chassis_has_bearer {
    default 0;
    "~^Bearer .+$" 1;
}
map "$chassis_access:$chassis_has_bearer" $chassis_missing_human {
    default 0;
    "identity:0" 1;
    "team:0" 1;
}
server {
    listen 3000;
    absolute_redirect off;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 102m;
    large_client_header_buffers 4 32k;
    location = /health {
        default_type application/json;
        return 200 '{"status":"ok","service":"ui-liveness"}';
    }
    location /api/telemetry/ {
        if ($chassis_ambiguous_path) { return 404; }
        if ($chassis_service_credential) { return 403; }
        if ($chassis_access = denied) { return 404; }
        if ($chassis_missing_human) { return 401; }
        proxy_pass https://${KDD_TELEMETRY_HOST}:${KDD_TELEMETRY_PORT}/;
        proxy_ssl_server_name on;
        proxy_ssl_name ${KDD_TELEMETRY_HOST};
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_set_header Host ${KDD_TELEMETRY_HOST};
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Team-ID $http_x_team_id;
        proxy_set_header X-API-Key "${KDD_TELEMETRY_API_KEY}";
        proxy_set_header Cookie "";
        proxy_connect_timeout 10s;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }
    location /api/ { return 404; }
    location /pit-wall/ {
        alias /usr/share/nginx/html/;
        try_files $uri $uri/ /pit-wall/index.html;
    }
    location / { try_files $uri $uri/ /index.html; }
}
